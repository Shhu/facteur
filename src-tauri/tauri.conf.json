{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "facteur",
  "version": "0.9.6",
  "identifier": "dev.facteur.mail",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --dir ui generate",
    "frontendDist": "../ui/.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "facteur",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https: http: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' about: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Mail client"
  }
}
